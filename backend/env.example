# RPS Observer 環境變數配置範例
# 複製此文件為 .env 並填入您的 API 金鑰

# LLM 服務提供商設定 (可選值: openai, deepseek-official, deepseek-reasoner, openrouter, gemini-2.5-pro, claude-3-7-sonnet-20250219)
MODEL_PROVIDER=deepseek-reasoner

# OpenAI API 配置 (支援多個金鑰，提高效率)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_KEY_2=your_second_openai_api_key_here
OPENAI_API_KEY_3=your_third_openai_api_key_here

# DeepSeek 官方 API 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Gemini API 配置
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API 配置 (用於 DeepSeek 等第三方模型)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_SITE_URL=https://your-site.com
OPENROUTER_SITE_NAME=RPS Observer

# 其他 LLM 提供商配置
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# 日誌配置
LLM_LOG_PROMPT=0
LLM_LOG_DIR=logs/llm

# 策略配置
USE_DYNAMIC_STRATEGIES=1
